<?xml version="1.0" encoding="utf-8"?>
<!--
First Motive OpenArm description with a backend-selectable ros2_control System.

This wraps openarm_description's geometry (the openarm_v20_robot macro) and injects
First Motive's own <ros2_control> blocks instead of upstream's fixed bimanual ones.
The geometry is preset-driven; the control blocks are emitted to match exactly the
arms the preset enables, so single-arm presets (right_arm) and bimanual presets
(default_bimanual) both produce a consistent controller set.

Args:
  robot_preset   openarm_description v2.0 preset (right_arm, default_bimanual, ...)
  hand           loader | pinch  (default loader). loader is the arm fm-rob-01's loader
                 runs: its parallel-jaw hand (prismatic fingers, 0..0.05 m, grasp_frame
                 0.18 m out) and its joint limits, from fm_description's loader
                 variant of robot_preset. pinch is openarm_description's stock preset
                 with the v2.0 pinch gripper. right_arm and left_arm carry no gripper,
                 so they stay stock under either value; a gripper preset with no
                 loader variant fails under loader. Only default_bimanual has one.
  sim_backend    mock | mujoco | gz | gazebo | isaac | real  (selects the System
                 plugin; gz is an alias for gazebo, anything else fails the xacro)
  can_interface  SocketCAN device for the real backend (ignored by sim backends)
  can_fd         CAN-FD toggle for the real backend
-->
<!-- name must match the MoveIt SRDF (openarm_v20) so Servo/MoveIt accept the pair. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openarm_v20">

  <xacro:arg name="robot_preset" default="right_arm"/>
  <xacro:arg name="hand" default="loader"/>
  <xacro:arg name="sim_backend" default="mock"/>
  <!-- Sets `backend`: gz becomes gazebo, and an unknown value fails the xacro. -->
  <xacro:include filename="$(find fm_control)/urdf/sim_backend.xacro"/>
  <xacro:fm_sim_backend
      requested="$(arg sim_backend)"
      supported="${['mock', 'mujoco', 'gazebo', 'isaac', 'real']}"/>
  <xacro:arg name="collapse_internal_empty_links" default="true"/>
  <xacro:arg name="emit_grasp_frame" default="false"/>
  <xacro:arg name="can_interface" default="can0"/>
  <xacro:arg name="can_fd" default="true"/>
  <xacro:arg name="isaac_joint_commands_topic" default="/isaac_joint_commands"/>
  <xacro:arg name="isaac_joint_states_topic" default="/isaac_joint_states"/>
  <!-- MJCF the MuJoCo backend loads. MujocoSystemInterface reads it from this URDF
       <param>, not a node param. The path is owned by fm_sim_models and injected by
       the fm_bringup registry when sim_backend=mujoco; the default stays empty. -->
  <xacro:arg name="mujoco_model" default=""/>
  <xacro:property name="mujoco_model_path" value="$(arg mujoco_model)"/>
  <!-- Controllers file the Gazebo gz_ros2_control plugin loads into its embedded
       controller_manager. Only used by the gazebo backend. -->
  <xacro:arg name="gazebo_controllers_file" default=""/>

  <!-- Geometry from openarm_description, plus First Motive's ros2_control macros. -->
  <xacro:include filename="$(find openarm_description)/assets/robot/openarm_v2.0/urdf/utils/openarm_v20_robot.xacro"/>
  <xacro:include filename="$(find fm_control)/urdf/openarm.ros2_control.xacro"/>
  <xacro:include filename="$(find fm_description)/urdf/openarm_cameras.xacro"/>
  <xacro:include filename="$(find fm_description)/urdf/openarm_parallel_hand.xacro"/>

  <xacro:property name="robot_root" value="$(find openarm_description)/assets/robot/openarm_v2.0"/>
  <xacro:property name="config_root" value="${robot_root + '/config'}"/>

  <!-- The preset name becomes a file path, so it must be a plain name. -->
  <xacro:property name="preset_name" value="$(arg robot_preset)"/>
  <xacro:unless value="${preset_name[:1].isalpha() and preset_name.isascii()
                         and preset_name.replace('_', '').isalnum()}">
    ${xacro.fatal('invalid robot_preset: ' + repr(preset_name))}
  </xacro:unless>
  <!-- `hand` is the arg as given; `loader_hand` below is whether the loader hand is
       built. An arm spec's `hand` key says only that the arm has some gripper. -->
  <xacro:property name="hand" value="$(arg hand)"/>
  <xacro:unless value="${hand in ['loader', 'pinch']}">
    ${xacro.fatal('unknown hand: ' + str(hand) + ' (expected loader or pinch)')}
  </xacro:unless>
  <xacro:property name="stock_cfg"
      value="${xacro.load_yaml(config_root + '/robot_presets/' + preset_name + '.yaml')}"/>
  <!-- Presets fm_description has a loader variant of, under config/openarm/loader_presets. -->
  <xacro:property name="loader_presets" value="${['default_bimanual']}"/>
  <xacro:property name="loader_hand" value="${hand == 'loader' and preset_name in loader_presets}"/>
  <xacro:if value="${hand == 'loader' and not loader_hand
                     and len([n for n in stock_cfg['robot']['components']
                              if stock_cfg[n]['type'] == 'end_effector'
                              and stock_cfg[n]['enabled']]) > 0}">
    ${xacro.fatal('robot_preset ' + preset_name + ' has no loader-hand variant'
                  + ' (one of ' + ', '.join(loader_presets) + '); pass hand:=pinch')}
  </xacro:if>
  <xacro:property name="preset_cfg"
      value="${xacro.load_yaml('$(find fm_description)/config/openarm/loader_presets/'
                               + preset_name + '.yaml') if loader_hand else stock_cfg}"/>

  <!-- Emit links + joints for the preset. -->
  <xacro:openarm_v20_robot
      config_root="${config_root}"
      robot_preset="${preset_cfg}"
      collapse_internal_empty_links="$(arg collapse_internal_empty_links)"
      emit_grasp_frame="$(arg emit_grasp_frame)"/>

  <!-- Resolve one spec per enabled arm: its prefix and whether it carries a gripper
       (the loader hand, or an enabled end_effector attached to it). Iteration order
       follows the preset's robot.components, so joint order matches the geometry. -->
  <xacro:property name="components" value="${preset_cfg['robot']['components']}"/>
  <xacro:property name="arm_names"
      value="${[n for n in components
                if preset_cfg[n]['type'] == 'robot'
                and preset_cfg[n]['config'] == 'arm'
                and preset_cfg[n]['enabled']]}"/>
  <!-- mirror_sign is the preset's sagittal reflect on Y (+1 for a base arm, -1 for the
       mirrored arm). The left arm is the right reflected about the XZ plane, so equal joint
       angles would tilt both arms the SAME world direction; the reflected joints must be
       sign-flipped by mirror_sign to spawn as a true mirror. Applied in arm_specs below;
       consumed by openarm_arm_joints.
       `ready` is the RIGHT-arm spawn joint vector: for a bimanual preset (2+ arms) a
       "hands forward, ~20cm apart" pre-grasp pose so the 1:1 mirror's engage baseline matches
       a natural two-hand start; for a single arm the original splayed bent-ready pose. -->
  <xacro:property name="ready_bimanual" value="${[0.6816, 0.0265, -0.3161, 1.1622, 0.0, 0.3, 0.0]}"/>
  <xacro:property name="ready_single" value="${[0.0, 0.5, 0.0, 1.2, 0.0, 0.3, 0.0]}"/>
  <xacro:property name="arm_specs"
      value="${[dict(prefix=preset_cfg[n]['prefix'],
                     ready=[(preset_cfg[n].get('reflect', dict()).get('y', 1) if i != 3 else 1)
                            * (ready_bimanual if len(arm_names) > 1 else ready_single)[i]
                            for i in python.range(7)],
                     hand=loader_hand or len([m for m in components
                               if preset_cfg[m]['type'] == 'end_effector'
                               and preset_cfg[m]['enabled']
                               and 'connection' in preset_cfg[m]
                               and 'attach_to' in preset_cfg[m]['connection']
                               and preset_cfg[m]['connection']['attach_to'] == n]) > 0)
                for n in arm_names]}"/>

  <!-- The loader hand on every arm, one arm per call. -->
  <xacro:macro name="openarm_parallel_hands" params="arm_specs index">
    <xacro:if value="${index &lt; len(arm_specs)}">
      <xacro:openarm_parallel_hand
          prefix="${arm_specs[index]['prefix']}"
          flange="${arm_specs[index]['prefix']}link7"
          emit_grasp_frame="$(arg emit_grasp_frame)"/>
      <xacro:openarm_parallel_hands arm_specs="${arm_specs}" index="${index + 1}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:if value="${loader_hand}">
    <xacro:openarm_parallel_hands arm_specs="${arm_specs}" index="0"/>
  </xacro:if>

  <xacro:property name="single_system_backends" value="${['mujoco', 'gazebo']}"/>

  <!-- Control gains feed the real backend only; loaded once and passed through. -->
  <xacro:property name="control_gains"
      value="${xacro.load_yaml(config_root + '/arm/control/control_gains.yaml')}"/>

  <!-- The simulators share one system across both arms: MuJoCo loads one MJCF world
       per system, and gz_ros2_control never initialises its hardware with two. Every
       other backend, real hardware included, keeps one system per arm. -->
  <xacro:if value="${backend in single_system_backends}">
    <xacro:openarm_single_system arm_specs="${arm_specs}" sim_backend="${backend}"/>
  </xacro:if>
  <xacro:unless value="${backend in single_system_backends}">
    <xacro:openarm_emit_arm_systems
        arm_specs="${arm_specs}"
        index="0"
        sim_backend="${backend}"
        control_gains="${control_gains}"
        can_interface="$(arg can_interface)"
        can_fd="$(arg can_fd)"
        isaac_joint_commands_topic="$(arg isaac_joint_commands_topic)"
        isaac_joint_states_topic="$(arg isaac_joint_states_topic)"/>
  </xacro:unless>

  <!-- Camera frames on whichever links this preset carries. -->
  <xacro:property name="right_arms" value="${[s for s in arm_specs if s['prefix'] == 'openarm_right_']}"/>
  <xacro:openarm_cameras
      body="${'body' in components and preset_cfg['body']['enabled']}"
      right_arm="${len(right_arms) > 0}"
      right_hand="${len(right_arms) > 0 and right_arms[0]['hand']}"
      loader_hand="${loader_hand}"
      collapse_empty_links="$(arg collapse_internal_empty_links)"/>

  <!-- Gazebo hosts the controller_manager inside the sim via this world plugin,
       which loads the controllers.yaml. Emitted only for the gazebo backend. -->
  <xacro:if value="${backend == 'gazebo'}">
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg gazebo_controllers_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
