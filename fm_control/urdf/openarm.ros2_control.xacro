<?xml version="1.0"?>
<!--
First Motive backend-selectable ros2_control for the OpenArm.

One <ros2_control> system per enabled arm, except under mujoco and gazebo, which
get a single system for every arm (openarm_single_system).
The controllers, controller_manager, and the command/state interface set stay
identical across every backend, except gazebo's extra finger_joint2 state (below) —
only the <hardware> System plugin swaps, selected by the `sim_backend` arg:

  mock    -> mock_components/GenericSystem        (no sim; perfect state echo)
  mujoco  -> mujoco_ros2_control/MujocoSystemInterface  (Mac daily driver, CPU)
  gazebo  -> gz_ros2_control/GazeboSimSystem      (Linux/GPU)
  isaac   -> topic_based_ros2_control/TopicBasedSystem  (Isaac Sim over ROS topics)
  real    -> openarm_hardware/OpenArmHW           (Linux SocketCAN -> DM motors)

Joint names mirror openarm_description geometry exactly: <prefix>joint1..7, plus
<prefix>finger_joint1 when the arm carries a gripper. `prefix` is the preset's full
arm prefix, e.g. openarm_right_. Under gazebo the system also lists
<prefix>finger_joint2, state only, so gz_ros2_control drives it as the mimic of
finger_joint1; DART has no mimic constraint and the finger would not move.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Emit the <hardware> block for the selected backend. control_gains/can_* are
       consumed only by the real backend; sim backends ignore them. -->
  <xacro:macro name="openarm_backend_hardware"
      params="prefix sim_backend control_gains can_interface can_fd
              isaac_joint_commands_topic isaac_joint_states_topic">

    <xacro:if value="${sim_backend == 'mock'}">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="fake_sensor_commands">false</param>
        <param name="state_following_offset">0.0</param>
      </hardware>
    </xacro:if>

    <xacro:if value="${sim_backend == 'mujoco'}">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <!-- MujocoSystemInterface reads the MJCF from this URDF param.
             mujoco_model_path is set by the top-level xacro. -->
        <param name="mujoco_model">${mujoco_model_path}</param>
        <!-- Headless: step physics with no GLFW window; the operator views the sim
             through Foxglove / the desktop app, never MuJoCo's own window. Required on
             macOS, where the plugin runs its GLFW loop off the main thread (Cocoa
             forbids that and the launch hangs). On Linux the container's xvfb-run
             wrapper then wraps a windowless process — a harmless no-op. -->
        <param name="headless">true</param>
      </hardware>
    </xacro:if>

    <xacro:if value="${sim_backend == 'gazebo'}">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
    </xacro:if>

    <xacro:if value="${sim_backend == 'isaac'}">
      <hardware>
        <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        <param name="joint_commands_topic">${isaac_joint_commands_topic}</param>
        <param name="joint_states_topic">${isaac_joint_states_topic}</param>
      </hardware>
    </xacro:if>

    <xacro:if value="${sim_backend == 'real'}">
      <hardware>
        <plugin>openarm_hardware/OpenArmHW</plugin>
        <param name="can_interface">${can_interface}</param>
        <param name="arm_prefix">${prefix}</param>
        <param name="can_fd">${can_fd}</param>
        <param name="kp1">${control_gains['joint1']['kp']}</param>
        <param name="kp2">${control_gains['joint2']['kp']}</param>
        <param name="kp3">${control_gains['joint3']['kp']}</param>
        <param name="kp4">${control_gains['joint4']['kp']}</param>
        <param name="kp5">${control_gains['joint5']['kp']}</param>
        <param name="kp6">${control_gains['joint6']['kp']}</param>
        <param name="kp7">${control_gains['joint7']['kp']}</param>
        <param name="kd1">${control_gains['joint1']['kd']}</param>
        <param name="kd2">${control_gains['joint2']['kd']}</param>
        <param name="kd3">${control_gains['joint3']['kd']}</param>
        <param name="kd4">${control_gains['joint4']['kd']}</param>
        <param name="kd5">${control_gains['joint5']['kd']}</param>
        <param name="kd6">${control_gains['joint6']['kd']}</param>
        <param name="kd7">${control_gains['joint7']['kd']}</param>
      </hardware>
    </xacro:if>
  </xacro:macro>

  <!-- One joint: position/velocity/effort command + position/velocity/effort state.
       Identical across backends so the controller set never changes. -->
  <xacro:macro name="openarm_joint" params="joint_name initial_position:=0.0">
    <joint name="${joint_name}">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">${initial_position}</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <!-- One arm's joints: 7 arm joints, plus finger_joint1 when it carries a gripper.
       Shared by the per-arm systems and the single system, so both emit the same
       interfaces and spawn pose. mimic_finger adds finger_joint2 with no command
       interface, which ros2_control reads as the URDF <mimic> of finger_joint1. -->
  <xacro:macro name="openarm_arm_joints"
      params="prefix hand init1 init2 init3 init4 init5 init6 init7 mimic_finger:=false">
    <!-- Spawn in a bent "ready" pose, NOT all-zeros. joint4 (elbow) has lower limit
         = 0, so a zeros spawn sits AT the joint limit AND fully extended (a kinematic
         singularity) — MoveIt Servo then emergency-stops every cycle and refuses to
         jog (logs "close to a position limit. Halting" + "Very close to a singularity").
         A bent elbow lifts it off both. initial_value is applied by the sim hardware.

         `ready` is the RIGHT-arm ready joint vector (per preset, from openarm.sim.urdf.xacro):
         the single-arm splayed pose, or the bimanual "hands forward, ~20cm apart" pre-grasp
         pose (so the 1:1 mirror's engage baseline matches a natural two-hand start instead
         of the arms being ~59cm apart). mirror_sign flips the reflected (left) arm's ready
         pose so both arms spawn as sagittal mirror images: the left arm is the right reflected
         about Y with joint AXES pointing the SAME world direction (the reflect macro mirrors
         joint ORIGINS, not axes), so by the mirror identity M*R(a,q)*M = R(M*a,-q) the
         reflected joints {1,2,3,5,6,7} need NEGATED angles; joint4 (excluded from the reflect)
         keeps its sign. The per-joint initN are the FINAL (mirror-applied) spawn angles,
         computed per arm in openarm.sim.urdf.xacro's arm_specs. -->
    <xacro:openarm_joint joint_name="${prefix}joint1" initial_position="${init1}"/>
    <xacro:openarm_joint joint_name="${prefix}joint2" initial_position="${init2}"/>
    <xacro:openarm_joint joint_name="${prefix}joint3" initial_position="${init3}"/>
    <xacro:openarm_joint joint_name="${prefix}joint4" initial_position="${init4}"/>
    <xacro:openarm_joint joint_name="${prefix}joint5" initial_position="${init5}"/>
    <xacro:openarm_joint joint_name="${prefix}joint6" initial_position="${init6}"/>
    <xacro:openarm_joint joint_name="${prefix}joint7" initial_position="${init7}"/>

    <xacro:if value="${hand}">
      <xacro:openarm_joint joint_name="${prefix}finger_joint1"/>
      <xacro:if value="${mimic_finger}">
        <joint name="${prefix}finger_joint2">
          <state_interface name="position"/>
        </joint>
      </xacro:if>
    </xacro:if>
  </xacro:macro>

  <!-- One <ros2_control> system for a single arm: backend hardware + that arm's
       joints. -->
  <xacro:macro name="openarm_arm_system"
      params="prefix hand sim_backend control_gains
              init1 init2 init3 init4 init5 init6 init7
              can_interface:=can0 can_fd:=true
              isaac_joint_commands_topic:=/isaac_joint_commands
              isaac_joint_states_topic:=/isaac_joint_states">

    <ros2_control name="${prefix}system" type="system">
      <xacro:openarm_backend_hardware
          prefix="${prefix}"
          sim_backend="${sim_backend}"
          control_gains="${control_gains}"
          can_interface="${can_interface}"
          can_fd="${can_fd}"
          isaac_joint_commands_topic="${isaac_joint_commands_topic}"
          isaac_joint_states_topic="${isaac_joint_states_topic}" />
      <xacro:openarm_arm_joints
          prefix="${prefix}" hand="${hand}"
          init1="${init1}" init2="${init2}" init3="${init3}" init4="${init4}"
          init5="${init5}" init6="${init6}" init7="${init7}"/>
    </ros2_control>
  </xacro:macro>

  <!-- Recurse over the resolved arm specs (one dict per enabled arm) and emit a
       system for each. Iteration mirrors openarm_description's index recursion. -->
  <xacro:macro name="openarm_emit_arm_systems"
      params="arm_specs index sim_backend control_gains
              can_interface can_fd isaac_joint_commands_topic isaac_joint_states_topic">
    <xacro:if value="${index &lt; len(arm_specs)}">
      <xacro:property name="spec" value="${arm_specs[index]}" lazy_eval="false"/>
      <xacro:openarm_arm_system
          prefix="${spec['prefix']}"
          hand="${spec['hand']}"
          init1="${spec['ready'][0]}" init2="${spec['ready'][1]}" init3="${spec['ready'][2]}"
          init4="${spec['ready'][3]}" init5="${spec['ready'][4]}" init6="${spec['ready'][5]}"
          init7="${spec['ready'][6]}"
          sim_backend="${sim_backend}"
          control_gains="${control_gains}"
          can_interface="${can_interface}"
          can_fd="${can_fd}"
          isaac_joint_commands_topic="${isaac_joint_commands_topic}"
          isaac_joint_states_topic="${isaac_joint_states_topic}" />
      <xacro:openarm_emit_arm_systems
          arm_specs="${arm_specs}"
          index="${index + 1}"
          sim_backend="${sim_backend}"
          control_gains="${control_gains}"
          can_interface="${can_interface}"
          can_fd="${can_fd}"
          isaac_joint_commands_topic="${isaac_joint_commands_topic}"
          isaac_joint_states_topic="${isaac_joint_states_topic}" />
    </xacro:if>
  </xacro:macro>

  <!-- Recurse over the arm specs, emitting each arm's joints into the system the
       caller has open. -->
  <xacro:macro name="openarm_emit_arm_joints" params="arm_specs index mimic_finger:=false">
    <xacro:if value="${index &lt; len(arm_specs)}">
      <xacro:property name="spec" value="${arm_specs[index]}" lazy_eval="false"/>
      <xacro:openarm_arm_joints
          prefix="${spec['prefix']}"
          hand="${spec['hand']}"
          init1="${spec['ready'][0]}" init2="${spec['ready'][1]}" init3="${spec['ready'][2]}"
          init4="${spec['ready'][3]}" init5="${spec['ready'][4]}" init6="${spec['ready'][5]}"
          init7="${spec['ready'][6]}"
          mimic_finger="${mimic_finger}"/>
      <xacro:openarm_emit_arm_joints
          arm_specs="${arm_specs}" index="${index + 1}" mimic_finger="${mimic_finger}"/>
    </xacro:if>
  </xacro:macro>

  <!-- One <ros2_control> system holding every arm's joints, for the simulators.
       Each MujocoSystemInterface loads its own copy of the MJCF, so per-arm systems
       would step the arms in separate worlds where they cannot touch each other or
       the scene; gz_ros2_control stalls at "Waiting RM to load and initialize
       hardware" with two GazeboSimSystem systems and comes up with one. MuJoCo
       couples the fingers with an equality in the MJCF; Gazebo needs the mimic
       joint listed here. -->
  <xacro:macro name="openarm_single_system" params="arm_specs sim_backend">
    <ros2_control name="openarm_system" type="system">
      <!-- Placeholder prefix, gains, CAN and isaac topics: the mujoco and gazebo
           hardware read none of them. -->
      <xacro:openarm_backend_hardware
          prefix=""
          sim_backend="${sim_backend}"
          control_gains="${dict()}"
          can_interface=""
          can_fd="false"
          isaac_joint_commands_topic=""
          isaac_joint_states_topic="" />
      <xacro:openarm_emit_arm_joints
          arm_specs="${arm_specs}" index="0" mimic_finger="${sim_backend == 'gazebo'}"/>
    </ros2_control>
  </xacro:macro>

</robot>
