<?xml version="1.0"?>
<!--
First Motive backend-selectable ros2_control for the Almond Bot Axol.

Axol is bimanual: two independent 7-DOF arms sharing one base, each with a
gripper. On mock and isaac we emit ONE <ros2_control> system per arm
(axol_left_system, axol_right_system), each owning its 8 joints. On mujoco,
gazebo and real both arms share one system, axol_system (axol_single_system):
each MujocoSystemInterface loads its own copy of the MJCF, so per-arm systems
would step the arms in separate worlds; gz_ros2_control does not initialise two
GazeboSimSystem systems; and on real one process (fm-axol's shim) owns both CAN
buses, so one JointState per cycle carries every joint. The arm controllers claim
disjoint joint sets either way, so each arm still runs on its own controllers.
The command/state interface set stays identical across backends; only the
<hardware> System plugin swaps, selected by `sim_backend`:

  mock    -> mock_components/GenericSystem               (no sim; perfect state echo)
  mujoco  -> mujoco_ros2_control/MujocoSystemInterface   (Mac daily driver, CPU)
  gazebo  -> gz_ros2_control/GazeboSimSystem             (Linux/GPU)
  isaac   -> topic_based_ros2_control/TopicBasedSystem   (Isaac Sim over ROS topics)
  real    -> topic_based_ros2_control/TopicBasedSystem   (fm-axol's shim over ROS topics)

Joint names mirror the vendored upstream URDF exactly: {left,right}_{s1,s2,s3,e1,
e2,w1,w2}_0 (s=shoulder, e=elbow, w=wrist; the _0 suffix is the Onshape export's)
and {left,right}_finger_1_joint, the prismatic finger in metres. The second finger
(finger_2_joint) is a URDF mimic of the first, so no system claims it:
robot_state_publisher derives it.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Emit the <hardware> block for the selected backend. mujoco_model_path is
       consumed only by mujoco; the topics only by isaac and real. -->
  <xacro:macro name="axol_backend_hardware"
      params="sim_backend mujoco_model_path joint_commands_topic joint_states_topic">

    <xacro:if value="${sim_backend == 'mock'}">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="fake_sensor_commands">false</param>
        <param name="state_following_offset">0.0</param>
      </hardware>
    </xacro:if>

    <xacro:if value="${sim_backend == 'mujoco'}">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <!-- MujocoSystemInterface reads the MJCF from this URDF param and maps the
             system's joints onto the model's by name; the axol MJCF joint names match
             exactly. One system holds both arms (see axol_single_system). -->
        <param name="mujoco_model">${mujoco_model_path}</param>
        <!-- Headless: step physics with no GLFW window; the operator views the sim
             through Foxglove / the desktop app, never MuJoCo's own window. Required on
             macOS (Cocoa forbids the plugin's off-main-thread GLFW loop); a harmless
             no-op under the container's xvfb-run. -->
        <param name="headless">true</param>
      </hardware>
    </xacro:if>

    <xacro:if value="${sim_backend == 'gazebo'}">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
    </xacro:if>

    <!-- Isaac Sim and the real robot both sit behind sensor_msgs/JointState topics:
         the system publishes position commands and reads position, velocity and
         effort back. TopicBasedSystem seeds its commands from each state
         interface's initial_value and publishes them before any controller is
         active. On real every position seed is NaN (see axol_joint): a joint no
         controller owns is commanded NaN, which fm-axol's core reads as "hold",
         and a trajectory controller that activates on a NaN command takes its
         hold pose from the measured state. A finite seed (the ready pose) would
         instead be sent to the arm and held by each controller on activation.
         Isaac keeps the ready pose on purpose: Isaac Sim spawns the arms there,
         so the seed matches the state it reports. -->

    <xacro:if value="${sim_backend in ['isaac', 'real']}">
      <hardware>
        <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
        <param name="joint_commands_topic">${joint_commands_topic}</param>
        <param name="joint_states_topic">${joint_states_topic}</param>
      </hardware>
    </xacro:if>
  </xacro:macro>

  <!-- One joint: position command; position, velocity and effort state. The same
       set on every backend, so the controllers never change. initial_position
       seeds the mock/mujoco starting pose (defaults 0.0); with seeded false the
       position seed is NaN instead, for the real robot (see the topic backend). -->
  <xacro:macro name="axol_joint" params="joint_name initial_position:=0.0 seeded:=true">
    <joint name="${joint_name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <xacro:if value="${seeded}">
          <param name="initial_value">${initial_position}</param>
        </xacro:if>
        <xacro:unless value="${seeded}">
          <param name="initial_value">nan</param>
        </xacro:unless>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <!-- One arm's 7 joints and its finger. `prefix` is left_ or right_; `elbow_ready`
       bends the e1 joint out of the straight-arm singularity so MoveIt Servo can jog
       from the start (left e1 range [-0.4189, 2.618], right [-2.618, 0.4189], so the
       caller passes +/- accordingly). The finger starts at 0, the export's pose.
       Shared by the per-arm and single systems. -->
  <xacro:macro name="axol_arm_joints" params="prefix elbow_ready seeded:=true">
    <xacro:axol_joint joint_name="${prefix}s1_0" seeded="${seeded}"/>
    <xacro:axol_joint joint_name="${prefix}s2_0" seeded="${seeded}"/>
    <xacro:axol_joint joint_name="${prefix}s3_0" seeded="${seeded}"/>
    <xacro:axol_joint joint_name="${prefix}e1_0" initial_position="${elbow_ready}"
        seeded="${seeded}"/>
    <xacro:axol_joint joint_name="${prefix}e2_0" seeded="${seeded}"/>
    <xacro:axol_joint joint_name="${prefix}w1_0" seeded="${seeded}"/>
    <xacro:axol_joint joint_name="${prefix}w2_0" seeded="${seeded}"/>
    <xacro:axol_joint joint_name="${prefix}finger_1_joint" seeded="${seeded}"/>
  </xacro:macro>

  <!-- One <ros2_control> system for a single arm: backend hardware + its joints. -->
  <xacro:macro name="axol_arm_system"
      params="prefix sim_backend elbow_ready mujoco_model_path:=''
              joint_commands_topic:='' joint_states_topic:=''">

    <ros2_control name="axol_${prefix}system" type="system">
      <xacro:axol_backend_hardware
          sim_backend="${sim_backend}"
          mujoco_model_path="${mujoco_model_path}"
          joint_commands_topic="${joint_commands_topic}"
          joint_states_topic="${joint_states_topic}" />

      <xacro:axol_arm_joints prefix="${prefix}" elbow_ready="${elbow_ready}"/>
    </ros2_control>
  </xacro:macro>

  <!-- One <ros2_control> system holding both arms, for mujoco, gazebo and real. The
       elbow_ready values match the per-arm systems' in axol.sim.urdf.xacro. -->
  <xacro:macro name="axol_single_system"
      params="sim_backend left_elbow_ready right_elbow_ready mujoco_model_path:=''
              joint_commands_topic:='' joint_states_topic:=''">
    <ros2_control name="axol_system" type="system">
      <xacro:axol_backend_hardware
          sim_backend="${sim_backend}"
          mujoco_model_path="${mujoco_model_path}"
          joint_commands_topic="${joint_commands_topic}"
          joint_states_topic="${joint_states_topic}" />
      <xacro:axol_arm_joints prefix="left_" elbow_ready="${left_elbow_ready}"
          seeded="${sim_backend != 'real'}"/>
      <xacro:axol_arm_joints prefix="right_" elbow_ready="${right_elbow_ready}"
          seeded="${sim_backend != 'real'}"/>
    </ros2_control>
  </xacro:macro>

  <!-- The Ox cart's lift, as a state source only, for the real robot. The lift is
       set by hand with an allen key: it has no encoder and never moves while the
       stack runs, so a mock system reporting the position read at stack start
       (lift_position, metres, 0 fully raised) stands in for a sensor. It takes no
       command, so no controller claims it, and joint_state_broadcaster publishes it
       on /joint_states beside the arms, where robot_state_publisher and MoveIt read
       it. A value outside the joint's limit (0 to 0.4572 m, the vendored URDF's) fails
       the xacro, so a typo never reaches TF or the planning scene; NaN fails it too. -->
  <xacro:macro name="axol_lift_system" params="lift_position">
    <xacro:property name="lift_m" value="${float(lift_position)}"/>
    <xacro:unless value="${0.0 &lt;= lift_m &lt;= 0.4572}">
      ${xacro.fatal('lift_position out of range: ' + str(lift_position)
                    + ' (expected 0 to 0.4572 m)')}
    </xacro:unless>
    <ros2_control name="axol_lift_system" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
      <joint name="lift">
        <state_interface name="position">
          <param name="initial_value">${lift_m}</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="effort">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
